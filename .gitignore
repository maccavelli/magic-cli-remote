/bin/
# Local cache of build serial (source of truth is git tags build/BASE.N)
.build-counter
# Keep dist/ for local APKs and release binaries; ignore the artifacts inside
/dist/*.apk
/dist/*.aab
/dist/mcremote-*
/dist/mcrelay-*
/dist/SHA256SUMS
# CI stages the APK here; keep a local `make`-style run from dirtying status
apps/mobile/dist/
*.exe
*.test
*.out
coverage.out
.DS_Store
*.swp
*~
.idea/
.vscode/

# Flutter
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/
apps/mobile/**/GeneratedPluginRegistrant.*

