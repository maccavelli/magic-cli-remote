{
 "azure": [
  {
   "label": "API key",
   "prompts": [
    {
     "key": "resourceName",
     "message": "Enter Azure Resource Name",
     "placeholder": "e.g. my-models",
     "type": "text"
    }
   ],
   "type": "api"
  }
 ],
 "cloudflare-ai-gateway": [
  {
   "label": "Gateway API token",
   "prompts": [
    {
     "key": "accountId",
     "message": "Enter your Cloudflare Account ID",
     "placeholder": "e.g. 1234567890abcdef1234567890abcdef",
     "type": "text"
    },
    {
     "key": "gatewayId",
     "message": "Enter your Cloudflare AI Gateway ID",
     "placeholder": "e.g. my-gateway",
     "type": "text"
    }
   ],
   "type": "api"
  }
 ],
 "cloudflare-workers-ai": [
  {
   "label": "API key",
   "prompts": [
    {
     "key": "accountId",
     "message": "Enter your Cloudflare Account ID",
     "placeholder": "e.g. 1234567890abcdef1234567890abcdef",
     "type": "text"
    }
   ],
   "type": "api"
  }
 ],
 "digitalocean": [
  {
   "label": "Login with DigitalOcean",
   "type": "oauth"
  },
  {
   "label": "Paste Model Access Key",
   "type": "api"
  }
 ],
 "github-copilot": [
  {
   "label": "Login with GitHub Copilot",
   "prompts": [
    {
     "key": "deploymentType",
     "message": "Select GitHub deployment type",
     "options": [
      {
       "hint": "Public",
       "label": "GitHub.com",
       "value": "github.com"
      },
      {
       "hint": "Data residency or self-hosted",
       "label": "GitHub Enterprise",
       "value": "enterprise"
      }
     ],
     "type": "select"
    },
    {
     "key": "enterpriseUrl",
     "message": "Enter your GitHub Enterprise URL or domain",
     "placeholder": "company.ghe.com or https://company.ghe.com",
     "type": "text",
     "when": {
      "key": "deploymentType",
      "op": "eq",
      "value": "enterprise"
     }
    }
   ],
   "type": "oauth"
  }
 ],
 "gitlab": [
  {
   "label": "GitLab OAuth",
   "prompts": [
    {
     "key": "instanceUrl",
     "message": "GitLab instance URL",
     "placeholder": "https://gitlab.com",
     "type": "text"
    }
   ],
   "type": "oauth"
  },
  {
   "label": "GitLab Personal Access Token",
   "prompts": [
    {
     "key": "instanceUrl",
     "message": "GitLab instance URL",
     "placeholder": "https://gitlab.com",
     "type": "text"
    }
   ],
   "type": "api"
  }
 ],
 "openai": [
  {
   "label": "ChatGPT Pro/Plus (browser)",
   "type": "oauth"
  },
  {
   "label": "ChatGPT Pro/Plus (headless)",
   "type": "oauth"
  },
  {
   "label": "Manually enter API Key",
   "type": "api"
  }
 ],
 "poe": [
  {
   "label": "Login with Poe (browser)",
   "type": "oauth"
  },
  {
   "label": "Manually enter API Key",
   "type": "api"
  }
 ],
 "snowflake-cortex": [
  {
   "label": "Login with Snowflake (External Browser)",
   "prompts": [
    {
     "key": "account",
     "message": "Snowflake Account Identifier",
     "placeholder": "myorg-myaccount",
     "type": "text"
    },
    {
     "key": "role",
     "message": "Snowflake Role (optional)",
     "placeholder": "PUBLIC",
     "type": "text"
    }
   ],
   "type": "oauth"
  },
  {
   "label": "Paste PAT or bearer token manually",
   "prompts": [
    {
     "key": "account",
     "message": "Snowflake Account Identifier",
     "placeholder": "myorg-myaccount",
     "type": "text"
    }
   ],
   "type": "api"
  }
 ],
 "xai": [
  {
   "label": "SuperGrok Subscription",
   "type": "oauth"
  },
  {
   "label": "Manually enter API Key",
   "type": "api"
  }
 ]
}