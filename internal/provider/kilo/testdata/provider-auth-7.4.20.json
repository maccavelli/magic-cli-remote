    },
    {
      "label": "ChatGPT Pro/Plus (headless)",
      "type": "oauth"
    },
    {
      "label": "Manually enter API Key",
      "type": "api"
    }
  ],
  "poe": [
    {
      "label": "Login with Poe (browser)",
      "type": "oauth"
    },
    {
      "label": "Manually enter API Key",
      "type": "api"
    }
  ],
  "snowflake-cortex": [
