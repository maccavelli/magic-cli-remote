# Managed by `{{.Product}} setup-service` / `{{.Product}} --setup-service`.
# Do not hand-edit if you re-run setup (use --force to overwrite).
#
# User unit: systemctl --user status {{.UnitName}}
# Linger (survive logout): loginctl enable-linger $USER

[Unit]
Description={{.Description}}
Documentation=file://{{.DocsHint}}
After=network-online.target
Wants=network-online.target
# Wide enough that a transient bind/ACME failure at boot does not leave the
# unit failed (start-limit-hit).
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
WorkingDirectory={{.WorkingDirectory}}

# Prefer the installed binary path so upgrades + service stay aligned.
ExecStart={{.Binary}} serve{{if .ConfigPath}} --config {{.ConfigPath}}{{end}}{{if .DataDir}} --data-dir {{.DataDir}}{{end}}{{if .ListenHost}} --listen-host {{.ListenHost}}{{end}}{{if .ListenPort}} --listen-port {{.ListenPort}}{{end}}{{if .LogLevel}} --log-level {{.LogLevel}}{{end}}{{if .LogFormat}} --log-format {{.LogFormat}}{{end}}

# always (not on-failure): a persistent daemon should come back even after a
# clean exit or a plain SIGTERM kill.
Restart=always
RestartSec=5
TimeoutStopSec=45
# mixed (not control-group): mcrelay spawns no child processes — unlike
# mcremote, which must signal a whole cgroup so its engines stop gracefully
# (MADR 0019). Signalling only the main process is correct here.
KillMode=mixed
KillSignal=SIGTERM

# --- environment (user session + caches) ---
Environment=HOME={{.Home}}
Environment=USER={{.User}}
Environment=LOGNAME={{.User}}
Environment=PATH={{.Path}}
Environment=XDG_CONFIG_HOME={{.XDGConfigHome}}
Environment=XDG_DATA_HOME={{.XDGDataHome}}
Environment=XDG_STATE_HOME={{.XDGStateHome}}
Environment=XDG_CACHE_HOME={{.XDGCacheHome}}
{{if .XDGRuntimeDir}}Environment=XDG_RUNTIME_DIR={{.XDGRuntimeDir}}
{{end}}{{if .ExtraEnviron}}{{range .ExtraEnviron}}Environment={{.}}
{{end}}{{end}}

# Journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{.UnitName}}

# Hardening (user-unit safe). On by default; set any of these to false
# in a drop-in to disable. Do not omit them from this template.
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ProtectKernelTunables=true
ProtectControlGroups=true
SystemCallArchitectures=native
# mcrelay does not exec coding CLIs, so these are safe here (they are
# not on the mcremote unit). Disable in a drop-in if a host cannot apply them.
PrivateDevices=true
RestrictNamespaces=true
# 0091 D4: probed 2026-08-15 — bind + /healthz + register/join/splice
# succeeded under both of these on a systemd --user unit (CGO_ENABLED=0).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=true
# ProtectClock/ProtectKernelModules/ProtectKernelLogs are deliberately absent:
# they imply capability-bounding-set changes a user manager cannot perform in
# container-restricted hosts (218/CAPABILITIES crash loop). ProtectHostname
# needs a UTS namespace, also commonly prohibited there.
# ProtectHome/ProtectSystem would hide $HOME ACME cache and config.
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=default.target
