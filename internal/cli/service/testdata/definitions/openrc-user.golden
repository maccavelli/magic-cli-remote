#!/sbin/openrc-run
# Managed by `mcremote setup-service` / `mcremote --setup-service`.
# Do not hand-edit if you re-run setup (use --force to overwrite).
# OpenRC user service: rc-service --user mcremote status
description='mcremote multi-CLI remote control daemon'
supervisor=supervise-daemon
command=''\''/opt/my apps/it'\''\'\'''\''s/mcremote'\'''
command_args='serve --config /home/u/.config/mcremote/config.yaml --data-dir '\''/home/u/data dir'\'' --listen-host 127.0.0.1 --listen-port 7531 --log-level debug --log-format json'
directory='/home/u/work'
supervise_daemon_args='--env HOME=/home/u --env USER=u --env LOGNAME=u --env PATH=/home/u/.local/bin:/usr/bin:/bin --env XDG_CONFIG_HOME=/home/u/.config --env XDG_DATA_HOME=/home/u/.local/share --env XDG_STATE_HOME=/home/u/.local/state --env XDG_CACHE_HOME=/home/u/.cache --env XDG_RUNTIME_DIR=/run/user/1000 --env '\''TOKEN=a '\''\'\'''\''quoted'\''\'\'''\'' $value'\'' --env EMPTY='
pidfile="${XDG_RUNTIME_DIR}"'/mcremote.pid'
output_log='/home/u/.local/state/mcremote/log/mcremote.log'
error_log='/home/u/.local/state/mcremote/log/mcremote.log'
respawn_delay=5
respawn_max=30
respawn_period=300
retry="TERM/45/KILL/5"
notify="socket:ready"

start_pre() {
	checkpath -d -m 0700 '/home/u/.local/state/mcremote/log'
}
