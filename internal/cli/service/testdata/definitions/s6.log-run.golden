#!/bin/sh
# Managed by `mcremote setup-service` / `mcremote --setup-service`.
# Do not hand-edit if you re-run setup (use --force to overwrite).
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
mkdir -p -m 0700 '/home/u/.local/state/mcremote/log' || exit 1
exec s6-log T '/home/u/.local/state/mcremote/log'
