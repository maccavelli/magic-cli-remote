# Managed by `{{.Product}} setup-service` / `{{.Product}} --setup-service`.
# Do not hand-edit if you re-run setup (use --force to overwrite).
#
# User unit: systemctl --user status {{.UnitName}}
# Linger (survive logout): loginctl enable-linger $USER

[Unit]
Description={{.Description}}
Documentation=file://{{.DocsHint}}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Resolve relative paths against a stable home workspace.
WorkingDirectory={{.WorkingDirectory}}

# Prefer the installed binary path so upgrades + service stay aligned.
ExecStart={{.Binary}} serve{{if .ConfigPath}} --config {{.ConfigPath}}{{end}}{{if .DataDir}} --data-dir {{.DataDir}}{{end}}{{if .ListenHost}} --listen-host {{.ListenHost}}{{end}}{{if .ListenPort}} --listen-port {{.ListenPort}}{{end}}{{if .LogLevel}} --log-level {{.LogLevel}}{{end}}{{if .LogFormat}} --log-format {{.LogFormat}}{{end}}

# always (not on-failure): a persistent daemon should come back even after a
# clean exit or a plain SIGTERM kill.
Restart=always
RestartSec=2
TimeoutStopSec=45
# control-group (not mixed): SIGTERM reaches every process in the cgroup, so a
# spawned `opencode serve` engine gets a graceful stop and can flush its session
# storage. Under KillMode=mixed only the main process is signalled and the
# engine is SIGKILLed after TimeoutStopSec — or leaks entirely if the daemon
# dies without running its shutdown path (MADR 0019).
KillMode=control-group
KillSignal=SIGTERM

# --- environment (user session + caches) ---
Environment=HOME={{.Home}}
Environment=USER={{.User}}
Environment=LOGNAME={{.User}}
Environment=PATH={{.Path}}
Environment=XDG_CONFIG_HOME={{.XDGConfigHome}}
Environment=XDG_DATA_HOME={{.XDGDataHome}}
Environment=XDG_STATE_HOME={{.XDGStateHome}}
Environment=XDG_CACHE_HOME={{.XDGCacheHome}}
{{if .XDGRuntimeDir}}Environment=XDG_RUNTIME_DIR={{.XDGRuntimeDir}}
{{end}}{{if .ExtraEnviron}}{{range .ExtraEnviron}}Environment={{.}}
{{end}}{{end}}

# Journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{.UnitName}}

# Hardening (user-unit safe)
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ProtectKernelTunables=true
ProtectControlGroups=true
SystemCallArchitectures=native
# ProtectClock/ProtectKernelModules/ProtectKernelLogs are deliberately absent:
# they imply capability-bounding-set changes a user manager cannot perform in
# container-restricted hosts (218/CAPABILITIES crash loop). ProtectHostname
# needs a UTS namespace, also commonly prohibited there. The directives above
# are mount-namespace/seccomp based and degrade gracefully.
# MemoryDenyWriteExecute breaks some Go plugins/cgo edge cases — leave off.
LimitNOFILE=65536

[Install]
WantedBy=default.target
