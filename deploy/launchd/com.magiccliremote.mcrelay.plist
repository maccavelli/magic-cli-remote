<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd user LaunchAgent example for mcrelay.

  Prefer:  make install && mcrelay setup-service --force
  This file is a review/manual reference; setup-service is the source of truth.

  Manual install (session agent — no sudo; stops on logout):
    mkdir -p ~/Library/LaunchAgents ~/Library/Logs/mcrelay
    # edit paths below for your home + binary
    cp deploy/launchd/com.magiccliremote.mcrelay.plist ~/Library/LaunchAgents/
    plutil -lint ~/Library/LaunchAgents/com.magiccliremote.mcrelay.plist
    launchctl bootout "gui/$(id -u)/com.magiccliremote.mcrelay" 2>/dev/null || true
    launchctl enable "gui/$(id -u)/com.magiccliremote.mcrelay"
    launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/com.magiccliremote.mcrelay.plist
    launchctl kickstart -k "gui/$(id -u)/com.magiccliremote.mcrelay"

  Do not use legacy: launchctl load / unload
  Ports < 1024 need a privileged front proxy (user agents cannot setcap like Linux).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.magiccliremote.mcrelay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_ME/.local/bin/mcrelay</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Users/REPLACE_ME/.config/mcrelay/config.yaml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/REPLACE_ME</string>
    <key>USER</key>
    <string>REPLACE_ME</string>
    <key>LOGNAME</key>
    <string>REPLACE_ME</string>
    <key>PATH</key>
    <string>/Users/REPLACE_ME/.local/bin:/Users/REPLACE_ME/.grok/bin:/Users/REPLACE_ME/.opencode/bin:/Users/REPLACE_ME/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>XDG_CONFIG_HOME</key>
    <string>/Users/REPLACE_ME/.config</string>
    <key>XDG_DATA_HOME</key>
    <string>/Users/REPLACE_ME/.local/share</string>
    <key>XDG_CACHE_HOME</key>
    <string>/Users/REPLACE_ME/.cache</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>ExitTimeOut</key>
  <integer>45</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/mcrelay/mcrelay.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/mcrelay/mcrelay.err.log</string>
</dict>
</plist>
