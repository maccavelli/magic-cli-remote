# System-wide (root) unit — for multi-user servers.
# For a normal developer machine, prefer the user unit:
#   mcremote --setup-service
# See also: deploy/systemd/mcremote.user.service
# Embedded source of truth for the user unit:
#   internal/cli/service/mcremote.user.service.tmpl

[Unit]
Description=mcremote multi-CLI remote control daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# "tailscale" binds the host's Tailscale IPv4 only. The daemon refuses to
# start if no tailnet address exists rather than widening to 0.0.0.0.
# Prefer baking listen settings in /etc/mcremote/config.yaml and omitting
# --listen-host / --listen-port so config edits apply without unit rewrites.
ExecStart=/usr/local/bin/mcremote serve --listen-host tailscale --listen-port 7531
# always (not on-failure): come back after clean exits and plain SIGTERM kills.
Restart=always
RestartSec=2
TimeoutStopSec=45
# control-group (not mixed): SIGTERM reaches every process in the cgroup, so a
# spawned `opencode serve` engine gets a graceful stop and can flush its session
# storage. Under KillMode=mixed only the main process is signalled and the
# engine is SIGKILLed after TimeoutStopSec — or leaks entirely if the daemon
# dies without running its shutdown path (MADR 0019).
KillMode=control-group
KillSignal=SIGTERM

# Optional:
# Environment=MCREMOTE_LOG_FORMAT=json
# Environment=MCREMOTE_LISTEN_HOST=tailscale
# 0.0.0.0 is an explicit opt-in and exposes the daemon beyond the tailnet:
# Environment=MCREMOTE_LISTEN_HOST=0.0.0.0
# Environment=MCREMOTE_CONFIG=/etc/mcremote/config.yaml
# Environment=MCREMOTE_DATA_DIR=/var/lib/mcremote

# Run as a dedicated user in production.
# User=mcremote
# Group=mcremote
# WorkingDirectory=/var/lib/mcremote

NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
