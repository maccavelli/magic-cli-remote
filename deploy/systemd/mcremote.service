# System-wide (root) unit — for multi-user servers.
# For a normal developer machine, prefer the user unit:
#   mcremote --setup-service
# See also: deploy/systemd/mcremote.user.service

[Unit]
Description=mcremote multi-CLI remote control daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mcremote serve --listen-host 0.0.0.0 --listen-port 7531
Restart=on-failure
RestartSec=2
# Optional:
# Environment=MCREMOTE_LOG_FORMAT=json
# Environment=MCREMOTE_LISTEN_HOST=0.0.0.0
# Environment=MCREMOTE_CONFIG=/etc/mcremote/config.yaml

# Run as a dedicated user in production.
# User=mcremote
# Group=mcremote

[Install]
WantedBy=multi-user.target
