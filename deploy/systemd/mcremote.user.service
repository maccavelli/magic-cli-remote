# Example user unit (mirrors the template embedded in the binary).
# Prefer installing via:
#   mcremote --setup-service
#   mcremote setup-service --force
#
# The embedded template (internal/cli/service/mcremote.user.service.tmpl) is
# the source of truth. setup-service fills paths from the installing user
# session; this file uses systemd %h / static PATH for manual copy.
#
# Manual install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/mcremote.user.service ~/.config/systemd/user/mcremote.service
#   # edit ExecStart / Environment as needed
#   systemctl --user daemon-reload
#   systemctl --user enable --now mcremote.service
#   loginctl enable-linger $USER
#
# Listen host/port are intentionally omitted from ExecStart so values come
# from config.yaml (or env). Pass --listen-host / --listen-port to
# setup-service only when you want them baked into the unit.

[Unit]
Description=mcremote multi-CLI remote control daemon
Documentation=file://%h/.config/mcremote
# User units cannot order on system tailscaled.service (different manager).
# The daemon waits in-process for listen.host=tailscale instead of exiting.
After=network-online.target
Wants=network-online.target
# Wide enough that a fail-fast binary still survives a tailscaled boot race
# (old installs, or any other transient start error). The daemon itself no
# longer exits when the tailnet address is late.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
# Resolve relative paths and provider default_cwd against a stable home workspace.
WorkingDirectory=%h

# Prefer the installed binary path so upgrades + service stay aligned.
ExecStart=%h/.local/bin/mcremote serve

# always (not on-failure): a persistent daemon should come back even after a
# clean exit or a plain SIGTERM kill.
Restart=always
RestartSec=5
TimeoutStopSec=45
# control-group (not mixed): SIGTERM reaches every process in the cgroup, so a
# spawned `opencode serve` engine gets a graceful stop and can flush its session
# storage. Under KillMode=mixed only the main process is signalled and the
# engine is SIGKILLed after TimeoutStopSec — or leaks entirely if the daemon
# dies without running its shutdown path (MADR 0019).
KillMode=control-group
KillSignal=SIGTERM

# --- environment (user session + caches) ---
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.grok/bin:%h/.opencode/bin:%h/go/bin:%h/.local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=GOCACHE=/cache/go
Environment=GOTMPDIR=/cache/tmp
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share
Environment=XDG_CACHE_HOME=%h/.cache

# --- optional MCREMOTE_* overrides (uncomment / set as needed) ---
# Environment=MCREMOTE_CONFIG=%h/.config/mcremote/config.yaml
# Environment=MCREMOTE_LISTEN_HOST=tailscale
# Environment=MCREMOTE_LISTEN_PORT=7531
# Environment=MCREMOTE_LOG_LEVEL=info
# Environment=MCREMOTE_LOG_FORMAT=text
# Environment=MCREMOTE_DATA_DIR=%h/.local/share/mcremote
# Environment=MCREMOTE_AUTH_REQUIRE_DEVICE_TOKEN=true
# Environment=MCREMOTE_AUTH_REQUIRE_CLIENT_KEY=true
# Environment=MCREMOTE_TLS_MODE=selfsigned
# Environment=MCREMOTE_PAIR_ADVERTISE_HOST=
# Environment=MCREMOTE_RELAY_URL=wss://relay.example.com
# Environment=MCREMOTE_RELAY_HOST_ID=your-host-id
# Environment=MCREMOTE_RELAY_SECRET=your-relay-secret
# Environment=MCREMOTE_PROVIDERS_GROK_PERMISSION_MODE=auto

# Journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcremote

# Hardening (user-unit safe; no filesystem/namespace restrictions — the
# daemon must exec arbitrary coding CLIs under $HOME)
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ProtectKernelTunables=true
ProtectControlGroups=true
SystemCallArchitectures=native
# ProtectClock/ProtectKernelModules/ProtectKernelLogs are deliberately absent:
# they imply capability-bounding-set changes a user manager cannot perform in
# container-restricted hosts (218/CAPABILITIES crash loop). ProtectHostname
# needs a UTS namespace, also commonly prohibited there.
LimitNOFILE=65536

[Install]
WantedBy=default.target
