<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!--
      In-app APK updates (MADR 0065 P4/P5).

      UPDATE_PACKAGES_WITHOUT_USER_ACTION only takes effect for the installer
      of record, so on a sideloaded build it is inert and the user still
      confirms each install. Kept because a future Play/self-hosted install
      path would need it, and it grants nothing on its own.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>

    <!--
      Foreground service + notifications (P0: "walk away and get pinged").
      The service keeps the WebSocket to the daemon alive over Tailscale while
      the app is backgrounded, so permission-needed / turn-complete events can
      raise a local notification. remoteMessaging is the apt FGS type: the
      service exists to relay agent messages and approvals to/from the host.
      All local + mesh only — no cloud push, matching the app's no-telemetry,
      self-hosted model.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>
    <!--
      WAKE_LOCK: nothing in this app acquires one. The foreground service sets
      allowWakeLock/allowWifiLock false on purpose (it keeps the process alive
      for alerts and must not hold radio or CPU locks while a parked connection
      waits on its slow maintenance retry), and no notification is scheduled.

      MADR 0084 D3 said it "was removed", but flutter_foreground_task's own
      manifest declares it unconditionally and the merger put it straight back —
      so the shipped APK carried it for the life of that claim (MADR 0126 F3).
      tools:node="remove" is what actually removes it; a comment cannot.

      RECEIVE_BOOT_COMPLETED and the plugin's RebootReceiver are deliberately
      KEPT (0126 P3 step 2): the app now sets autoRunOnMyPackageReplaced, so the
      keep-alive service returns by itself after an in-app APK update instead of
      waiting for the user to tap the "Updated" notification. autoRunOnBoot
      stays false, so nothing starts at boot.

      VIBRATE and ACCESS_NETWORK_STATE are also kept and are NOT dead weight:
      the ask and error channels are Importance.high with vibration left at its
      default, and connectivity_plus needs ACCESS_NETWORK_STATE for the
      onConnectivityChanged signal the reconnect path depends on.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove"/>

    <!-- Voice input (speech_to_text): dictate a prompt hands-free. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!--
      allowBackup=false plus the backup_rules / data_extraction_rules below keep
      the device token, host and device_id out of Auto Backup (cloud) and out of
      Android 12+ device-to-device transfer. allowBackup=false alone already
      disables both; the rule files are belt-and-braces if it is ever flipped.

      usesCleartextTraffic is deliberately absent. The daemon terminates TLS
      (self-signed cert, fingerprint pinned by the app from the pair QR), so
      cleartext is disabled in network_security_config.xml instead - that file
      also documents how to allow it for a single host if someone genuinely
      runs `mcremote serve` with tls=false.
    -->
    <!--
      enableOnBackInvokedCallback opts into Android 13+'s predictive back API.
      The app theme already selects PredictiveBackPageTransitionsBuilder
      (lib/theme/celestial.dart), but that builder animates from the
      `startBackGesture` events the engine only delivers to an app that has
      registered an OnBackInvokedCallback — without this attribute it silently
      fell back to the plain fade transition (MADR 0042 D9).
    -->
    <application
        android:label="Magic CLI Remote"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              The mcremote://pair?host=&token= deep-link intent-filter was
              removed deliberately. Nothing in the app consumes incoming
              intents (bare FlutterActivity, no app_links/uni_links), so it was
              an exported entry point that any installed app or web page could
              fire at MainActivity with attacker-chosen host/token while no
              handler validated it. Pair payloads are read from the QR scanner
              and clipboard instead (see PairPayload.tryParse).

              If deep linking is added later: re-add this filter TOGETHER with a
              handler that validates the payload and requires explicit user
              confirmation before applying a host/token.
            -->
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Monochrome status-bar icon for the foreground-service notification.
             flutter_foreground_task resolves the drawable via this meta-data
             name (see ForegroundServiceController). Without it the service
             notification falls back to the full-colour launcher icon, which the
             status bar renders as a white blob. -->
        <meta-data
            android:name="com.maccavelli.magic_cli_remote.notification_icon"
            android:resource="@drawable/ic_stat_mc" />

        <!--
          flutter_foreground_task: the service that keeps the mesh socket alive
          in the background, plus its restart receiver.

          android:stopWithTask is DELIBERATELY ABSENT (MADR 0126 D1/D2). It used
          to be "true", and the plugin reads that flag back through
          ForegroundServiceUtils.isSetStopWithTaskFlag() to switch off every
          recovery path at once — so the RestartReceiver below, and the comment
          that said it "relaunches the service if the OS kills it", were dead
          code in the shipped configuration. What each path is worth now:

            START_STICKY                  reliable. The OS recreates the service
                                          itself, so API 31+'s background-FGS-
                                          start rule does not apply.
            onDestroy restart alarm       best-effort on API 31+ (see below).
            onTaskRemoved restart alarm   best-effort on API 31+ (see below).
            RebootReceiver                LIVE for MY_PACKAGE_REPLACED only.
                                          autoRunOnMyPackageReplaced is true
                                          (0126 P3 step 2), so the service
                                          returns by itself after an in-app
                                          update; autoRunOnBoot stays false, so
                                          nothing starts at boot. Measured
                                          2026-09-02 (0126 P7 row 3): after a
                                          package replace the OS logged
                                          "Background started FGS: Allowed ...
                                          code:PACKAGE_REPLACED" and the service
                                          came back with zero MainActivity
                                          records — no Activity was ever
                                          started. This line previously read
                                          "inert: ... both left at their false
                                          defaults", which stopped being true
                                          when P3 step 2 landed.

          "Best-effort" precisely: RestartReceiver.setRestartAlarm uses
          setAlarmClock only when canScheduleExactAlarms() is true, and this app
          holds neither SCHEDULE_EXACT_ALARM nor USE_EXACT_ALARM, so it takes the
          inexact AlarmManager.set(RTC_WAKEUP, ...) branch. An inexact alarm is
          not on Android 12's foreground-service-launch exemption list, so the
          receiver's startForegroundService throws
          ForegroundServiceStartNotAllowedException unless the app is exempt from
          battery optimisation. Do NOT add an exact-alarm permission to fix that
          (0126 C3) — START_STICKY is the part that carries the feature.

          The trade this makes: swiping the app off recents no longer guarantees
          the service is gone. That was the original point of stopWithTask, and
          it is given up on purpose, because the service existing IS the feature
          ("walk away and get pinged"). The user keeps an explicit off switch —
          NotificationCoordinator stops the service on sign-out and whenever the
          notifications master toggle goes off (notification_coordinator.dart
          :277-278, :315-321).
        -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="remoteMessaging"
            android:exported="false" />
        <!--
          remoteMessaging is deliberate and must not be "tidied" to dataSync
          (MADR 0084 finding D7): Android 15's 6-hour-per-24-hour foreground
          service timeout — after which Service.onTimeout fires and an ANR
          follows if the service does not stop — applies to dataSync and
          mediaProcessing only. remoteMessaging is exempt, and is also among
          the types permitted to start without a visible activity, which is
          what "walk away and get pinged" needs.
        -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RestartReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          flutter_local_notifications' action-button receiver (MADR 0129 P5).

          Required for Allow/Deny to work with the app swiped away. An action
          shown with showsUserInterface:false targets this receiver by
          PendingIntent.getBroadcast; the receiver spins up a short-lived
          FlutterEngine running notificationBackgroundHandler, which forwards
          the decision to the foreground-service isolate holding the socket.

          The plugin does NOT declare it — its own manifest contributes two
          uses-permission entries and no components — and this app never had
          it. A PendingIntent for an undeclared receiver is created without
          error and delivered to nothing, so that path was silently dead for
          the whole life of the background handler.

          exported="false": the only legitimate sender is the notification the
          app itself posted, and the PendingIntent carries the app's own
          identity. Nothing outside the package has business answering a
          permission prompt on the user's behalf. This is also why the entry
          does not appear in manifest-surface.allow — that gate records
          exported components and permissions, and this is neither.
        -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- FileProvider for APK install content URIs (0065 P4). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PackageInstaller status + MY_PACKAGE_REPLACED (0065 P5). -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.maccavelli.magic_cli_remote.INSTALL_STATUS" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So speech_to_text can discover the on-device recognizer (Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
