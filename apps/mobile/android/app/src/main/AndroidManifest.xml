<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- In-app APK updates (MADR 0065 P4/P5). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>

    <!--
      Foreground service + notifications (P0: "walk away and get pinged").
      The service keeps the WebSocket to the daemon alive over Tailscale while
      the app is backgrounded, so permission-needed / turn-complete events can
      raise a local notification. remoteMessaging is the apt FGS type: the
      service exists to relay agent messages and approvals to/from the host.
      All local + mesh only — no cloud push, matching the app's no-telemetry,
      self-hosted model.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Voice input (speech_to_text): dictate a prompt hands-free. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!--
      allowBackup=false plus the backup_rules / data_extraction_rules below keep
      the device token, host and device_id out of Auto Backup (cloud) and out of
      Android 12+ device-to-device transfer. allowBackup=false alone already
      disables both; the rule files are belt-and-braces if it is ever flipped.

      usesCleartextTraffic is deliberately absent. The daemon terminates TLS
      (self-signed cert, fingerprint pinned by the app from the pair QR), so
      cleartext is disabled in network_security_config.xml instead - that file
      also documents how to allow it for a single host if someone genuinely
      runs `mcremote serve` with tls=false.
    -->
    <!--
      enableOnBackInvokedCallback opts into Android 13+'s predictive back API.
      The app theme already selects PredictiveBackPageTransitionsBuilder
      (lib/theme/celestial.dart), but that builder animates from the
      `startBackGesture` events the engine only delivers to an app that has
      registered an OnBackInvokedCallback — without this attribute it silently
      fell back to the plain fade transition (MADR 0042 D9).
    -->
    <application
        android:label="Magic CLI Remote"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              The mcremote://pair?host=&token= deep-link intent-filter was
              removed deliberately. Nothing in the app consumes incoming
              intents (bare FlutterActivity, no app_links/uni_links), so it was
              an exported entry point that any installed app or web page could
              fire at MainActivity with attacker-chosen host/token while no
              handler validated it. Pair payloads are read from the QR scanner
              and clipboard instead (see PairPayload.tryParse).

              If deep linking is added later: re-add this filter TOGETHER with a
              handler that validates the payload and requires explicit user
              confirmation before applying a host/token.
            -->
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Monochrome status-bar icon for the foreground-service notification.
             flutter_foreground_task resolves the drawable via this meta-data
             name (see ForegroundServiceController). Without it the service
             notification falls back to the full-colour launcher icon, which the
             status bar renders as a white blob. -->
        <meta-data
            android:name="com.maccavelli.magic_cli_remote.notification_icon"
            android:resource="@drawable/ic_stat_mc" />

        <!-- flutter_foreground_task: the service that keeps the mesh socket
             alive in the background, plus its restart receiver (relaunches the
             service if the OS kills it). stopWithTask keeps it from lingering
             after the app is swiped away. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="remoteMessaging"
            android:stopWithTask="true"
            android:exported="false" />
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RestartReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- FileProvider for APK install content URIs (0065 P4). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PackageInstaller status + MY_PACKAGE_REPLACED (0065 P5). -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.maccavelli.magic_cli_remote.INSTALL_STATUS" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So speech_to_text can discover the on-device recognizer (Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
