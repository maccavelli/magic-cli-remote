<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) rules covering both cloud backup and device-to-device
  transfer. Redundant while android:allowBackup="false", but kept so the app
  never silently starts transferring credentials if that attribute is changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
